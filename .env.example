# ── Required ── set at least ONE of the two LLM keys ───────────────────────
# Sarvam is used first when its key is set; Groq is the automatic backup.
SARVAM_API_KEY=
# Get your free Groq key at: https://console.groq.com
GROQ_API_KEY=

# ── Optional: NVIDIA NIM (kept for future use) ─────────────────────────────
NVIDIA_API_KEY=

# ── Optional: LangSmith Observability ──────────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true to enable LangSmith tracing.
# Get your key at https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=self-auditing-agent
